# Copy to .env and fill in your API keys

# Azure OpenAI (used for GPT Image-2 generation + GPT-5.4 critique)
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://your-resource.openai.azure.com/

# Anthropic via Databricks (used for Claude Opus evaluation + revision)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_BASE_URL=https://your-workspace.databricks.com/

# Google Gemini (image generation + round-2 critique)
GOOGLE_API_KEY=AI...
# By default the key is used against the Gemini Developer API, which serves both
# the image and critique models with no region pinning. Set this to true only if
# your credentials can reach those models through Vertex — with an API key,
# Vertex runs in Express Mode, where Google pins the project/region and the SDK
# refuses an explicit location, so a model missing from that region 404s with no
# way to route around it.
# GEMINI_USE_VERTEX=false

# MAI image models (Azure AI Foundry). Used when MAI-Image 2 / 2.5 is selected.
# Bearer auth against the OpenAI-compatible /images/generations route.
# If unset, the OPENAI_API_KEY / OPENAI_BASE_URL above are used as a fallback.
MAI_BASE_URL=https://your-resource.services.ai.azure.com/openai/v1
MAI_API_KEY=...
# MAI_OUTPUT_FORMAT=png
# MAI_OUTPUT_COMPRESSION=100

# --- Optional model overrides ---
# All model names below are optional; if unset, the defaults in config.py apply.
# Use these to point a stage at a different deployment, e.g. a more capable
# OpenAI critic (gpt-5.4-pro) or a different Anthropic evaluator.

# Anthropic evaluator + reviser (default: claude-opus-4-7)
# EVAL_MODEL=claude-opus-4-7

# OpenAI critic, round 1 (default: gpt-5.4)
# CRITIQUE_MODEL=gpt-5.4-pro

# Gemini critic, round 2 (default: gemini-3.1-pro-preview)
# CRITIQUE_ROUND2_MODEL=gemini-3.1-pro-preview

# Critic token budgets (defaults: 16384 each). These cap reasoning + visible output
# together, so a reasoning critic such as gpt-5.4-pro can spend the entire budget
# thinking and return no text at all. Raise these if a critique round fails with
# "incomplete_reason=max_output_tokens".
# CRITIQUE_MAX_TOKENS=16384
# CRITIQUE_ROUND2_MAX_TOKENS=16384

# Evaluation/revision budget (default: 32768). Raise this if a run fails with
# "LLM output appears truncated before a complete JSON object" — dense prompts
# produce much longer evaluations than typical ones.
# LLM_MAX_TOKENS=32768

# Default image generators (the in-app dropdowns can still override per run)
# IMAGE_GEN_GPT_MODEL=gpt-image-2
# IMAGE_GEN_GEMINI_MODEL=gemini-3-pro-image-preview

# --- Orchestrator ---
# Set true to run the LangGraph orchestrator (graph_pipeline.py) instead of the
# legacy pipeline.py. Adds a SQLite checkpoint at runs/checkpoints.db so a
# human-in-the-loop pause is a real suspend and a crashed run resumes without
# redoing image generation. Run artifacts are identical either way, so the flag
# is safe to flip back.
# USE_GRAPH_ORCHESTRATOR=false
